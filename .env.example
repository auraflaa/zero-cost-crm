# Copy to .env.local for development or .env for Docker.
# Never commit either file.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convobrains_crm
# Optional local override (takes precedence over DATABASE_URL):
# DB_URL_DEV=postgresql://postgres:postgres@localhost:5432/convobrains_crm
DB_SSL=false

PORT=4000

# Required — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-value

# Email allow-list for login / user creation.
# Any domain (default for generic OSS installs):
ALLOWED_EMAIL_DOMAIN=*
# Single org domain:
# ALLOWED_EMAIL_DOMAIN=convobrains.com
# Multiple domains: ALLOWED_EMAIL_DOMAIN=example.com,acme.com

# Optional branding bootstrap (used when seeding app_settings on first migrate).
# After first boot, change branding/stages/statuses via Settings UI or PATCH /api/settings.
# BRAND_NAME=Convobrains CRM
# BRAND_TAGLINE=Founder sales ops
# BRAND_LOGO_URL=/convobrains-logo.png

# Comma-separated browser origins allowed for CORS.
# Leave empty in production behind the same origin (recommended).
# Local Vite + API example:
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Optional: S3-backed call recordings (all four required when using uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Optional: AI providers for voice/image extraction and lead scoring
# mock (default, no external calls, deterministic local scoring)
# Groq example: AI_PROVIDER=groq AI_API_KEY=gsk_... AI_MODEL=llama-3.1-8b-instant AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct AI_WHISPER_MODEL=whisper-large-v3-turbo
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_WHISPER_MODEL=whisper-large-v3-turbo
# Optional ICP bootstrap (first migrate only)
# ICP_DESCRIPTION=We sell B2B SaaS to 50-500 employee healthcare teams in India
